# Urban Air Quality Assistant Configuration
# NASA Space Apps Challenge 2025

# Google Gemini API Key (optional - system falls back to local RAG synthesis if omitted)
GEMINI_API_KEY=

# OpenAQ API Key (optional - public endpoints used by default)
OPENAQ_API_KEY=

# OpenWeatherMap API Key (optional)
WEATHER_API_KEY=

# AirNow API Key (optional)
AIRNOW_API_KEY=
